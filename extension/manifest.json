{
  "manifest_version": 3,
  "name": "ResumeFit – tailor your resume to any job",
  "short_name": "ResumeFit",
  "version": "1.0.0",
  "description": "One click: read the job page, score your fit, and get a tailored resume and cover letter. Free. Uses your own Gemini key, nothing leaves your browser.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open ResumeFit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"]
}
